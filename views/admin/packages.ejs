<%- layout("/layout/admin") %><div class="admin-head"><div><span class="eyebrow">Content</span><h1>Journeys</h1><p>Update packages yourself, then publish when ready.</p></div><a class="button" href="/admin/packages/new">New journey +</a></div><section class="admin-card table-wrap"><table><thead><tr><th>Journey</th><th>Seasonal price</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody><% packages.forEach(pkg => { %><tr><td><b><%= pkg.title %></b><small><%= pkg.code %> · <%= pkg.days %> days</small></td><td>₹<%= pkg.seasonalPrices[0] ? pkg.seasonalPrices[0].price.toLocaleString("en-IN") : "—" %> / person</td><td><span class="pill <%= pkg.status %>"><%= pkg.status %></span></td><td><%= pkg.updatedAt.toLocaleDateString("en-IN") %></td><td><a href="/admin/packages/<%= pkg._id %>/edit">Edit →</a> <form class="inline" method="POST" action="/admin/packages/<%= pkg._id %>/duplicate"><button>Duplicate</button></form></td></tr><% }) %></tbody></table></section>
