<%- layout("/layout/admin") %>

<div class="admin-head">
  <div>
    <span class="eyebrow">Editorial Content</span>
    <h1>Blog CMS</h1>
    <p>Articles published on your own site that guide travellers directly to related packages.</p>
  </div>
  <a class="button" href="/admin/blogs/new">+ New Blog Post</a>
</div>

<section class="admin-card table-wrap">
  <table>
    <thead>
      <tr>
        <th>Article</th>
        <th>Category</th>
        <th>Status</th>
        <th>Published Date</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (!blogs || blogs.length === 0) { %>
        <tr>
          <td colspan="5" class="text-center muted">No blog posts found. Create your first article!</td>
        </tr>
      <% } else { %>
        <% blogs.forEach(blog => { %>
          <tr>
            <td>
              <strong><%= blog.title %></strong>
              <small><%= blog.slug %> · <%= blog.readTime %></small>
            </td>
            <td><span class="pill"><%= blog.category %></span></td>
            <td>
              <span class="pill <%= blog.status === 'published' ? 'published' : 'draft' %>">
                <%= blog.status %>
              </span>
            </td>
            <td><%= new Date(blog.publishedAt).toLocaleDateString("en-IN") %></td>
            <td>
              <a href="/blogs/<%= blog.slug %>" target="_blank">View ↗</a> &nbsp;|&nbsp;
              <a href="/admin/blogs/<%= blog._id %>/edit">Edit →</a> &nbsp;|&nbsp;
              <form class="inline" method="POST" action="/admin/blogs/<%= blog._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this blog post?');">
                <button class="ghost" style="color:#d9534f; padding:0.2rem 0.4rem;">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</section>

