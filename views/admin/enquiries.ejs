<%- layout("/layout/admin") %><div class="admin-head"><div><span class="eyebrow">Staff workspace</span><h1>Enquiries</h1><p>Every conversation in one calm place.</p></div><span class="pill new"><%= enquiries.filter(x => x.status === 'new').length %> need a reply</span></div><section class="admin-card table-wrap"><table><thead><tr><th>Traveller</th><th>Journey</th><th>Received</th><th>Status</th><th></th></tr></thead><tbody><% enquiries.forEach(item => { %><tr><td><b><%= item.name %></b><small><%= item.message.slice(0,80) %></small></td><td><%= item.package ? item.package.title : 'General enquiry' %></td><td><%= item.createdAt.toLocaleString('en-IN') %></td><td><span class="pill <%= item.status %>"><%= item.status.replace('_',' ') %></span></td><td><a href="/admin/enquiries/<%= item._id %>">Open →</a></td></tr><% }) %></tbody></table></section>
